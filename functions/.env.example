# Copy to functions/.env for a real cloud deploy. The Firebase CLI loads this file
# at deploy time. functions/.env is gitignored (it may hold secrets) - never commit it.
#
# For local emulator use, copy secrets to functions/.secret.local (also gitignored).
# See docs/SETUP.md §5b for how to provision secrets via Secret Manager.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Your Firebase Auth UID. The backend fails CLOSED if this is unset - every
# callable is rejected. Find it in the Firebase console -> Authentication ->
# Users, or by signing in and running: firebase auth:export users.json
# then reading the uid field. Set to the SAME value as VITE_OWNER_UID (web).
OWNER_UID=YOUR_FIREBASE_UID_HERE

# Cloud Functions region - the ONE place to set the backend region. Must match
# the region you chose for Firestore/Storage and VITE_FUNCTIONS_REGION (web).
# Defaults to africa-south1 if unset.
FUNCTIONS_REGION=africa-south1

# ── OPTIONAL: CORS ────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins for HTTP endpoints (e.g. ingest_email).
# Defaults to "*" if unset (open). Set to your hosting domain in production.
# CORS_ORIGINS=https://your-project-id.web.app,https://your-custom-domain.com

# ── OPTIONAL: APP CHECK ───────────────────────────────────────────────────────

# Set to "true" to enforce Firebase App Check on all callables. Requires
# VITE_RECAPTCHA_SITE_KEY (web) and App Check configured in the Firebase console.
# Leave unset or "false" to disable (App Check is optional).
# ENFORCE_APP_CHECK=true

# ── OPTIONAL: GMAIL AUTO-IMPORT ───────────────────────────────────────────────

# Only needed if you wire up the Apps Script email intake (docs/gmail-apps-script.gs).
# GMAIL_INTAKE_SECRET is a Secret Manager secret (set via `firebase functions:secrets:set`).
# GMAIL_OWNER_UID is a plain env var: set it here (same value as OWNER_UID).
# GMAIL_INTAKE_SECRET=   <- set via Secret Manager, not here
# GMAIL_OWNER_UID=YOUR_FIREBASE_UID_HERE

# ── OPTIONAL: SECURITY ALERT EMAILS (SMTP) ────────────────────────────────────

# When set, the backend sends a security notification email on suspicious events
# (failed auth, owner gate blocks, etc.). SMTP_PASS is a Secret Manager secret;
# the others are plain env vars that can live here.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# MAIL_FROM=you@example.com
# MAIL_FROM_NAME=MzansiMoney
# SMTP_PASS=   <- set via Secret Manager, not here
