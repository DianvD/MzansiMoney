# Copy to .env.local and fill in for a REAL Firebase project (cloud deploy).
# For local development against the emulators you can leave these unset - the app
# falls back to the "demo-mzansimoney" demo project and connects to the emulators.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions region. Must match FUNCTIONS_REGION in functions/.env and the
# region you chose for Firestore. Defaults to africa-south1 if unset.
# VITE_FUNCTIONS_REGION=africa-south1

# Owner allow-list (front-of-door gate). Denies any non-owner immediately after
# Google sign-in, before the PIN step. UX gate only - the backend OWNER_UID check
# and Firestore rules are the real enforcement. Set VITE_OWNER_UID to the SAME
# value as the functions' OWNER_UID; VITE_OWNER_EMAILS is an optional
# comma-separated alternative. Leave BOTH blank and the web won't block here.
# VITE_OWNER_UID=YOUR_FIREBASE_UID_HERE
# VITE_OWNER_EMAILS=

# App Check reCAPTCHA v3 site key (public - it ships in the page). Get it from
# Firebase console -> App Check -> register the Web app with the reCAPTCHA v3
# provider. Required if ENFORCE_APP_CHECK=true is set on the backend.
# Leave unset to skip App Check.
# VITE_RECAPTCHA_SITE_KEY=

# Force emulator mode on/off explicitly. Defaults to true in `vite dev`.
# VITE_USE_EMULATORS=true
